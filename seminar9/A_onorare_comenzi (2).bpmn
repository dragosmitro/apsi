      <bpmn:messageEventDefinition id="Msg_S" />
    </bpmn:startEvent>
    <bpmn:task id="T_stoc" name="Verifică stocul">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
