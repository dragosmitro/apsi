<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.1">
  <bpmn:process id="Proces_A" name="Onorarea comenzilor" isExecutable="false">
    <bpmn:startEvent id="S" name="Comandă primită">
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_S" />
    </bpmn:startEvent>
    <bpmn:task id="T_stoc" name="Verifică stocul">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Produs în stoc?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_rej" name="Respinge comanda">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_rej" name="Comandă respinsă">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_dep" name="Preia produsul din depozit">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_conf" name="Confirmă comanda">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="P1" name="">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_adr" name="Preia adresa de livrare">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="T_liv" name="Livrează produsul">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="T_fac" name="Emite factura">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="T_pla" name="Primește confirmarea plății">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="P2" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T_arh" name="Arhivează comanda">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_ok" name="Comandă onorată">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="T_conf" targetRef="P1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="P1" targetRef="T_adr" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T_adr" targetRef="T_liv" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T_liv" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="P1" targetRef="T_fac" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="T_fac" targetRef="T_pla" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T_pla" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="P2" targetRef="T_arh" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="T_arh" targetRef="E_ok" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="S" targetRef="T_stoc" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T_stoc" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_12" name="da" sourceRef="G1" targetRef="T_dep" />
    <bpmn:sequenceFlow id="Flow_13" name="nu" sourceRef="G1" targetRef="T_rej" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="T_rej" targetRef="E_rej" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T_dep" targetRef="T_conf" />
  </bpmn:process>
